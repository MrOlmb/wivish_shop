# =======================================================================
# WIVISH SHOP - ENVIRONMENT VARIABLES CONFIGURATION
# =======================================================================

# -----------------------------------------------------------------------
# AUTHENTICATION (Clerk)
# -----------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------
# MySQL Database URL
DATABASE_URL="mysql://username:password@localhost:3306/wivish_db"

# -----------------------------------------------------------------------
# PAYMENT PROVIDERS
# -----------------------------------------------------------------------
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# PayPal Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# -----------------------------------------------------------------------
# SEARCH ENGINE (Elasticsearch)
# -----------------------------------------------------------------------
ELASTICSEARCH_NODE=https://your-elasticsearch-instance.com
ELASTICSEARCH_USERNAME=your_elasticsearch_username
ELASTICSEARCH_PASSWORD=your_elasticsearch_password
ELASTICSEARCH_INDEX_NAME=wivish_products

# -----------------------------------------------------------------------
# FILE STORAGE (Cloudinary)
# -----------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=your_cloudinary_preset_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------
# EMAIL SERVICE (Resend/SendGrid/Nodemailer)
# -----------------------------------------------------------------------
# Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@wivish.com

# Alternative: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=noreply@wivish.com

# Alternative: SMTP (Nodemailer)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# -----------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------
# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Environment
NODE_ENV=development

# Admin Contact Information
ADMIN_EMAIL=admin@wivish.com
SUPPORT_EMAIL=support@wivish.com

# -----------------------------------------------------------------------
# ANALYTICS & MONITORING
# -----------------------------------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-your_ga_measurement_id

# Sentry Error Tracking (Optional)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# -----------------------------------------------------------------------
# API RATE LIMITING & SECURITY
# -----------------------------------------------------------------------
# JWT Secret for API authentication
JWT_SECRET=your_super_secret_jwt_key_here

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# -----------------------------------------------------------------------
# SHIPPING & LOGISTICS
# -----------------------------------------------------------------------
# Default shipping configuration
DEFAULT_SHIPPING_COUNTRY=France
DEFAULT_CURRENCY=EUR
DEFAULT_TAX_RATE=0.20

# Shipping providers API keys (if using external services)
# LAPOSTE_API_KEY=your_laposte_api_key
# CHRONOPOST_API_KEY=your_chronopost_api_key

# -----------------------------------------------------------------------
# SOCIAL MEDIA & EXTERNAL INTEGRATIONS
# -----------------------------------------------------------------------
# Social Media Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/wivish
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/wivish
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/wivish

# External API keys (if needed)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------
# Debug mode for development
DEBUG_MODE=false

# Prisma Studio Port
PRISMA_STUDIO_PORT=5555

# Webhook testing (for development)
WEBHOOK_SECRET=whsec_your_development_webhook_secret

# -----------------------------------------------------------------------
# MULTI-VENDOR SPECIFIC CONFIGURATION
# -----------------------------------------------------------------------
# Commission rates (percentage)
PLATFORM_COMMISSION_RATE=5.0
PAYMENT_PROCESSING_FEE=2.9

# Seller application settings
SELLER_APPROVAL_REQUIRED=true
AUTO_APPROVE_SELLERS=false

# Product moderation
PRODUCT_MODERATION_REQUIRED=true
AUTO_PUBLISH_PRODUCTS=false

# -----------------------------------------------------------------------
# CACHING & PERFORMANCE
# -----------------------------------------------------------------------
# Redis configuration (if using Redis for caching)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# Cache TTL in seconds
CACHE_TTL=3600

# -----------------------------------------------------------------------
# LOCALIZATION
# -----------------------------------------------------------------------
# Default locale and supported locales
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en

# Currency and formatting
DEFAULT_CURRENCY=EUR
CURRENCY_SYMBOL=€

# -----------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------
# Enable/disable features
FEATURE_WISHLIST=true
FEATURE_REVIEWS=true
FEATURE_CHAT_SUPPORT=true
FEATURE_AFFILIATE_PROGRAM=false
FEATURE_SUBSCRIPTION_PRODUCTS=false

# -----------------------------------------------------------------------
# BACKUP & MAINTENANCE
# -----------------------------------------------------------------------
# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site en maintenance. Nous reviendrons bientôt !"

# Backup configuration
# BACKUP_FREQUENCY=daily
# BACKUP_RETENTION_DAYS=30



> Lets go through the environment variables and complete the missing ones systematically.My .env file is not up to date, but the .env.example file gives us an idea of what   
  we need to add in our project.So i will your help getting to the right place for each resource.                                                                             